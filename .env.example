GEMINI_API_KEY = token
GROQ_API_KEY = gsk_your_groq_api_key_here
GROQ_BASE_URL = https://api.groq.com/openai/v1
GITHUB_TOKEN = token
DB_HOST=localhost
DB_PORT=5433
DB_NAME=context
DB_USER=postgres
DB_PASSWORD=devpass
CONFLUENCE_BASE_URL=https://kazelffl.atlassian.net
CONFLUENCE_EMAIL=your_email@example.com
CONFLUENCE_TOKEN=
MODEL=llama-3.3-70b-versatile

# Nguồn trace (Luồng 2). Mặc định http://localhost:16686
JAEGER_URL=http://localhost:16686

# Nguồn log runtime: Loki nhận log OTLP từ collector, mỗi dòng mang sẵn trace_id nên đếm được
# "trace này sinh bao nhiêu dòng log / bao nhiêu dòng lỗi". Không chạy thì dashboard chỉ bỏ trống
# ô log, các số liệu khác vẫn đủ.
LOKI_URL=http://localhost:13100

# Chỉ để dựng link "mở log của trace này trong Grafana" ở màn báo cáo.
GRAFANA_URL=http://localhost:18088
# LOKI_DATASOURCE_UID=loki

# Ánh xạ flow -> page id Confluence. Mặc định trong sources/confluence.py đã có đủ F1-F6 của
# space "Ewallet-demo"; chỉ cần đặt biến này khi dùng space khác.
# CONFLUENCE_FLOW_PAGES=F1=131083,F2=131100,F3=98486,F4=131117,F5=393229,F6=393246

# Thư mục chứa mapping/flow-map.yaml và mapping/F*.yaml. Bỏ trống thì dùng thư mục mapping/ của repo.
# MAPPING_DIR=/app/mapping

# Dashboard db-quality của từng service (Topic #80). Bỏ trống thì dùng mặc định trong config.py.
# DB_QUALITY_URLS=ewallet-payment-order=http://localhost:19082,ewallet-payment-business=http://localhost:19083,ewallet-third-party=http://localhost:19084,ewallet-notification=http://localhost:19085

# ---------- Trigger tự động (README §10) ----------
# SCHEDULER_ENABLED=true
# Mỗi ngày phân tích lại mọi flow vào giờ này (HH:MM). Để trống = tắt.
SCHEDULE_DAILY_AT=02:00
SCHEDULE_TZ=Asia/Ho_Chi_Minh
# Server tắt đúng giờ chạy thì lần khởi động sau trong ngày chạy bù.
# SCHEDULE_CATCH_UP=true
# Hỏi phiên bản các trang F1-F6 mỗi N giây; trang đổi thì phân tích lại flow đó. 0 = tắt.
CONFLUENCE_POLL_SECONDS=60
# Token cho POST /webhook/confluence (header X-VQ-Token). Trống = nhận mọi request.
CONFLUENCE_WEBHOOK_TOKEN=
# Debug/reloader của Flask. KHÔNG bật khi đã mở tunnel ra Internet.
# FLASK_DEBUG=1
